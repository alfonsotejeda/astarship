# Copia este fichero a `.env` y ajusta lo que necesites.
#   cp .env.example .env
# Los valores por defecto funcionan tal cual con `docker compose up -d`.

# --- PostgreSQL ---
POSTGRES_USER=rutopia
POSTGRES_PASSWORD=rutopia
POSTGRES_DB=rutopia
POSTGRES_PORT=5432

# --- API ---
# Al correr la API en local (fuera de Docker) el host es localhost.
# Dentro de docker compose, docker-compose.yml ya la sobrescribe con `db`.
DATABASE_URL=postgresql+psycopg://rutopia:rutopia@localhost:5432/rutopia
ENVIRONMENT=development
DEBUG=true
